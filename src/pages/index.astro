---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ResumePeek from '../components/ResumePeek.astro';
const projects = (await getCollection('projects')).filter((project) => project.data.featured).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Cameron Hildebrandt — Software Engineer" description="Personal site of Cameron Hildebrandt, a software engineer.">
  <div class="page" id="top">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="hero__name">Cameron<br />Hildebrandt</h1>
      <p class="hero__tagline gradient-text">Full-Stack Software Engineer</p>
      <ul class="hero__charms" aria-label="Areas of focus"><li>AI</li><li>ML</li><li>TypeScript</li><li>Angular</li><li>Node.js</li></ul>
      <div class="button-row">
        <ButtonLink href="https://github.com/your-handle" external icon="github">GitHub <span class="sr-only">(replace URL)</span></ButtonLink>
        <ButtonLink href="https://www.linkedin.com/in/your-handle" external variant="quiet" icon="linkedin">LinkedIn <span class="sr-only">(replace URL)</span></ButtonLink>
      </div>
    </section>
    <section id="about" aria-labelledby="about-title">
      <SectionHeading eyebrow="01 / About" title="The future is AI." />
      <div class="about-grid"><p class="mono">Machine learning · AI workflows</p><div><p>I’m a full-stack engineer with a background in machine learning, specializing in AI workflows and the systems that turn rapidly evolving technology into useful products.</p><p>My job is to bring ideas to life: from shaping an early concept through to a complete, reliable solution. Recently, that has meant building end-to-end AI solutions and security workflows that help teams move faster while staying deliberate about risk.</p><p>I believe the future is AI—not as a substitute for thoughtful engineering, but as a force multiplier for it. Used well, it can 10× code production and make ambitious ideas much more practical to build.</p><div class="button-row"><ButtonLink href="/resume/" variant="quiet" icon="resume">Resume</ButtonLink></div></div></div>
    </section>
    <section id="experience" aria-labelledby="experience-title">
      <SectionHeading eyebrow="02 / Experience" title="What I've Done" />
      <ExperienceTimeline />
      <div class="button-row"><ButtonLink href="/resume/" variant="quiet" icon="resume">Resume</ButtonLink></div>
    </section>
    <section id="projects" aria-labelledby="projects-title">
      <SectionHeading eyebrow="03 / Selected work" title="Projects with intent." />
      <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
      <div class="button-row"><ButtonLink href="/projects/" variant="quiet" icon="projects">Projects</ButtonLink></div>
    </section>
  </div>
  <ResumePeek />
</BaseLayout>
