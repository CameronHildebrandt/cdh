---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const projects = (await getCollection('projects')).sort((a, b) => b.data.priority - a.data.priority || b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Projects — Cameron Hildebrandt" description="Projects and case studies by Cameron Hildebrandt.">
  <div class="page"><header class="page-intro"><p class="eyebrow">Selected work</p><h1>Projects.</h1><p>A selection of ideas brought to life through thoughtful engineering - from applied AI and computer vision to polished, practical software systems. And also some things I thought would be fun to build!</p></header><div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div></div>
</BaseLayout>
