---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ResumeRender from '../components/ResumeRender.astro';
---
<BaseLayout title="Resume — Cameron Hildebrandt" description="Cameron Hildebrandt's resume">
  <div class="page resume-page"><header class="page-intro"><p class="eyebrow">Resume</p><h1>The short version.</h1><div class="button-row"><ButtonLink href="/resume.pdf" variant="quiet" icon="download">Download .PDF</ButtonLink><ButtonLink href="/resume.tex" variant="quiet" icon="code">Download .TEX</ButtonLink></div></header><ResumeRender /></div>
</BaseLayout>
