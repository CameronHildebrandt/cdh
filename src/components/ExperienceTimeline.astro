---
import resumeData from '../data/resume-data.json';

const monthIndexes: Record<string, number> = {
  jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,
  jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11,
};

const toDisplayText = (value: string) => value
  .replace(/\$\\rightarrow\$/g, '→')
  .replace(/\\%/g, '%')
  .replace(/\\\$/g, '$');

const formatDuration = (startDate: string, endDate: string, compact = false) => {
  const parseDate = (value: string) => {
    if (value === 'Present') return new Date();
    const [, month, year] = value.match(/^([A-Za-z]+)\.?\s+(\d{4})$/) ?? [];
    const monthIndex = monthIndexes[month?.slice(0, 3).toLowerCase() ?? ''];
    return monthIndex === undefined || !year ? null : new Date(Number(year), monthIndex, 1);
  };
  const start = parseDate(startDate);
  const end = parseDate(endDate);
  if (!start || !end) return { full: '', short: '' };

  const totalMonths = Math.max(0, (end.getFullYear() - start.getFullYear()) * 12 + end.getMonth() - start.getMonth());
  const years = Math.floor(totalMonths / 12);
  const months = totalMonths % 12;
  const parts = [
    years && (compact ? `${years}y` : `${years} ${years === 1 ? 'year' : 'years'}`),
    months && (compact ? `${months}m` : `${months} ${months === 1 ? 'month' : 'months'}`),
  ].filter(Boolean).join(' ');
  return compact ? { full: '', short: parts } : { full: parts, short: '' };
};

// The homepage intentionally reads the canonical JSON pool, not the generated TeX.
const experience = resumeData.experiences.map((item) => {
  const [startDate, endDate = 'Present'] = item.dates.split(/\s+-\s+/);
  const duration = formatDuration(startDate, endDate);
  const durationShort = formatDuration(startDate, endDate, true);

  return {
    ...item,
    title: toDisplayText(item.role),
    city: toDisplayText(item.city),
    startDate,
    endDate,
    isCurrent: endDate === 'Present',
    duration: duration.full,
    durationShort: durationShort.short,
    highlights: item.highlights.map(toDisplayText),
  };
});
---
<ol class="timeline">
  {experience.map((item, index) => (
    <li class="experience-preview" data-experience-preview role="button" tabindex="0" aria-expanded="false" aria-controls={`experience-timeline-${index}`}>
      <div class="experience-preview__content" id={`experience-timeline-${index}`}>
          <div class="timeline__date" data-experience-date={item.isCurrent ? '' : undefined} data-start-date={item.isCurrent ? item.startDate : undefined}><p class="mono">{item.startDate} — {item.endDate}</p>{item.duration && <p class="timeline__duration"><span class="timeline__duration-full">{item.duration}</span><span class="timeline__duration-short">{item.durationShort}</span></p>}</div>
          <article class="timeline__entry">
            <div><h3>{item.title}</h3><p class="timeline__meta">{item.company}{item.city && ` · ${item.city}`}</p></div>
            <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </article>
      </div>
      <div class="experience-preview__fade" aria-hidden="true"><span>Show full experience</span></div>
    </li>
  ))}
</ol>

<script>
  document.documentElement.classList.add('has-js');
  const monthIndexes: Record<string, number> = { jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11 };
  const currentDuration = (startDate: string) => {
    const [, month, year] = startDate.match(/^([A-Za-z]+)\.?\s+(\d{4})$/) ?? [];
    if (!month || !year) return null;
    const startMonth = monthIndexes[month.slice(0, 3).toLowerCase()];
    if (startMonth === undefined) return null;
    const today = new Date();
    const durationInMonths = Math.max(0, (today.getFullYear() - Number(year)) * 12 + today.getMonth() - startMonth);
    const years = Math.floor(durationInMonths / 12);
    const months = durationInMonths % 12;
    const full = [years && `${years} ${years === 1 ? 'year' : 'years'}`, months && `${months} ${months === 1 ? 'month' : 'months'}`].filter(Boolean).join(' ');
    const short = [years && `${years}y`, months && `${months}m`].filter(Boolean).join(' ');
    return { full, short };
  };
  document.querySelectorAll<HTMLElement>('[data-experience-date]').forEach((date) => {
    const duration = currentDuration(date.dataset.startDate ?? '');
    if (!duration) return;
    const full = date.querySelector<HTMLElement>('.timeline__duration-full');
    const short = date.querySelector<HTMLElement>('.timeline__duration-short');
    if (full) full.textContent = duration.full;
    if (short) short.textContent = duration.short;
  });
  document.querySelectorAll<HTMLElement>('[data-experience-preview]').forEach((preview) => {
    const content = preview.querySelector<HTMLElement>('.experience-preview__content');
    const measure = () => preview.style.setProperty('--expanded-height', `${content?.scrollHeight ?? 150}px`);
    measure();

    const toggle = () => {
      measure();
      const expanded = preview.classList.toggle('is-expanded');
      preview.setAttribute('aria-expanded', String(expanded));
    };

    preview.addEventListener('click', toggle);
    preview.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggle();
      }
    });
    window.addEventListener('resize', measure, { passive: true });
  });
</script>

<style>
  .timeline > .experience-preview { display:block; margin-bottom:.5rem; padding:0; }
  .experience-preview { border:1px solid transparent; border-radius:var(--radius); cursor:pointer; overflow:hidden; position:relative; transition:background .22s ease,border-color .22s ease,transform .22s ease; }
  .experience-preview:hover { background:var(--surface); border-color:var(--line); }
  .experience-preview:active { background:var(--surface-strong); transform:scale(.995); }
  .experience-preview:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .experience-preview__content { display:grid; gap:1.25rem; grid-template-columns:10rem minmax(0,1fr); padding:1rem; transition:max-height .52s cubic-bezier(.2,.75,.2,1),opacity .25s ease; }
  :global(.has-js) .experience-preview:not(.is-expanded) .experience-preview__content { max-height:150px; overflow:hidden; }
  :global(.has-js) .experience-preview.is-expanded .experience-preview__content { max-height:var(--expanded-height); }
  .experience-preview__fade { align-items:flex-end; background:linear-gradient(to bottom,transparent,var(--bg) 82%); bottom:0; display:none; justify-content:center; left:0; padding:3rem 1rem .8rem; pointer-events:none; position:absolute; right:0; }
  :global(.has-js) .experience-preview:not(.is-expanded) .experience-preview__fade { display:flex; }
  .experience-preview__fade span { color:var(--muted); font-family:"SFMono-Regular",Consolas,monospace; font-size:.65rem; letter-spacing:.08em; text-transform:uppercase; }
  .timeline > li:not(:last-child)::before { display:none; }
  .timeline__entry h3 { margin-bottom:.45rem; }
  .timeline__meta { margin-top:0; }
  .timeline__entry ul { color:var(--muted); list-style:disc outside; margin:.85rem 0 0; padding-left:1.1rem; }
  .timeline__entry li { display:list-item; }
  .timeline__date .mono { margin-bottom:.25rem; }
  .timeline__duration { color:var(--muted); font-family:"SFMono-Regular",Consolas,monospace; font-size:.63rem; letter-spacing:.05em; margin:0; }
  .timeline__duration-short { display:none; }
  .timeline__entry h3 { font-weight:750; }
  .timeline__entry::before { background:linear-gradient(180deg,rgb(235,51,69),rgb(234,63,237)); }

  @media (max-width:760px) {
    .experience-preview__content { gap:.5rem; grid-template-columns:1fr; }
    .timeline__date { align-items:center; display:flex; gap:.45rem; justify-content:space-between; }
    .timeline__date .mono,.timeline__duration { margin:0; white-space:nowrap; }
    .timeline__duration-full { display:none; }
    .timeline__duration-short { display:inline; }
  }
</style>
