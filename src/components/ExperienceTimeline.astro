---
import { experience } from '../data/experience';
---
<ol class="timeline">
  {experience.map((item, index) => (
    <li class="experience-preview" data-experience-preview role="button" tabindex="0" aria-expanded="false" aria-controls={`experience-timeline-${index}`}>
      <div class="experience-preview__content" id={`experience-timeline-${index}`}>
          <p class="timeline__date mono">{item.startDate} — {item.endDate}</p>
          <article class="timeline__entry">
            <div><h3>{item.title}</h3><p class="timeline__meta">{item.company}{item.city && ` · ${item.city}`}</p></div>
            <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </article>
      </div>
      <div class="experience-preview__fade" aria-hidden="true"><span>Show full experience</span></div>
    </li>
  ))}
</ol>

<script>
  document.documentElement.classList.add('has-js');
  document.querySelectorAll<HTMLElement>('[data-experience-preview]').forEach((preview) => {
    const toggle = () => {
      const expanded = preview.classList.toggle('is-expanded');
      preview.setAttribute('aria-expanded', String(expanded));
    };

    preview.addEventListener('click', toggle);
    preview.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggle();
      }
    });
  });
</script>

<style>
  .timeline > .experience-preview { display:block; margin-bottom:.5rem; padding:0; }
  .experience-preview { border:1px solid transparent; border-radius:var(--radius); cursor:pointer; overflow:hidden; position:relative; transition:background .22s ease,border-color .22s ease,transform .22s ease; }
  .experience-preview:hover { background:var(--surface); border-color:var(--line); }
  .experience-preview:active { background:var(--surface-strong); transform:scale(.995); }
  .experience-preview:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .experience-preview__content { display:grid; gap:1.25rem; grid-template-columns:10rem minmax(0,1fr); padding:1rem; transition:max-height .45s cubic-bezier(.2,.7,.2,1); }
  :global(.has-js) .experience-preview:not(.is-expanded) .experience-preview__content { max-height:150px; overflow:hidden; }
  .experience-preview__fade { align-items:flex-end; background:linear-gradient(to bottom,transparent,var(--bg) 82%); bottom:0; display:none; justify-content:center; left:0; padding:3rem 1rem .8rem; pointer-events:none; position:absolute; right:0; }
  :global(.has-js) .experience-preview:not(.is-expanded) .experience-preview__fade { display:flex; }
  .experience-preview__fade span { color:var(--muted); font-family:"SFMono-Regular",Consolas,monospace; font-size:.65rem; letter-spacing:.08em; text-transform:uppercase; }
  .timeline > li:not(:last-child)::before { display:none; }
  .timeline__entry h3 { margin-bottom:.45rem; }
  .timeline__meta { margin-top:0; }
  .timeline__entry ul { color:var(--muted); list-style:disc outside; margin:.85rem 0 0; padding-left:1.1rem; }
  .timeline__entry li { display:list-item; }

  @media (max-width:760px) {
    .experience-preview__content { gap:.5rem; grid-template-columns:1fr; }
  }
</style>
